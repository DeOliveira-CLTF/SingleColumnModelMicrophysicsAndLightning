{
  "schema_version": 1,
  "policy": "No EP, provisional coefficients or fixed IC/CG fraction. Fit one nonnegative scale; published functional form fixed. Negative published flash regressions require explicit physical-domain policy before use.",
  "sources": {
    "Romps2019": "https://doi.org/10.1029/2019GL085748",
    "Barthe2010": "https://doi.org/10.1029/2010JD014405",
    "McCaul2009": "https://doi.org/10.1175/2008WAF2222152.1",
    "Chronis2015": "https://doi.org/10.1175/WAF-D-14-00064.1"
  },
  "mass_basis": "r_i: kg hydrometeor per kg dry air; rho_i=rho_d*r_i; rho_d=p/(Rd*T*(1+rv/epsilon))",
  "column_support": "Area fixed independently of lightning error. Area representativeness must be accepted before fitting. Snapshot diagnostics integrated over complete bins, no endpoint sampling substitute.",
  "methods": [
    {"id":"IxG","version":"Romps2019_eq4","equation":"integral rho_i*rho_g dz","coefficients":{},"units":"kg2 m-5","thresholds":{},"support":"vertical whole column; temporal integral over 15min","requirements":["rho_d","qi","qg","dz"],"scm":"viable"},
    {"id":"CAPExP","version":"Romps2019_eq1","equation":"CAPE*P","coefficients":{},"units":"J kg-1 * kg m-2 s-1","thresholds":{},"support":"near-surface isentropic CAPE, ensuing precipitation interval; explicit alignment","requirements":["isentropic near-surface CAPE","total precipitation"],"scm":"conditional; CAPE implementation pending"},
    {"id":"PW10","version":"Romps2019_eq2","equation":"P*H(max_z(w)-10)","coefficients":{},"units":"kg m-2 s-1","thresholds":{"w_m_s":10},"support":"resolved convective column","requirements":["convective w","P"],"scm":"unavailable: no resolved convective w"},
    {"id":"IFluxT","version":"Romps2019_eq3","equation":"rho_i*w*H(w-1) at T=260K","coefficients":{},"units":"kg m-2 s-1","thresholds":{"T_K":260,"w_m_s":1},"support":"cloud ice only; lowest descending isotherm crossing","requirements":["collocated convective w and cloud ice"],"scm":"unavailable: no collocated convective w"},
    {"id":"McCaul2009","version":"original_blend","equation":"0.95*0.042*(w*r_g[g/kg])[-15C]+0.05*0.20*VII[kg/m2]","coefficients":{"r1":0.95,"r2":0.05,"k1":0.042,"k2":0.20},"units":"flashes km-2 (5min)-1","thresholds":{"T_K":258.15},"support":"resolved column; VII=integral rho_d*(ri+rs+rg)dz; original peak-density calibration support requires review for area means","requirements":["collocated convective w and qg","VII"],"scm":"unavailable: plume mean velocity cannot multiply column graupel"},
    {"id":"precipitation_ice_mass","version":"Barthe2010_eq1_Deierling2008","equation":"3.4e-8*pm-18.1","coefficients":{"a":3.4e-8,"b":-18.1},"units":"flashes min-1; pm kg","thresholds":{"T_K_less":268.15},"support":"storm volume","requirements":["storm geometry","precipitating ice"],"scm":"unavailable: unresolved storm volume"},
    {"id":"IWP18","version":"Barthe2010_eq2_Petersen2005","equation":"33.33*IWP-0.17","coefficients":{"a":33.33,"b":-0.17},"units":"flashes km-2 day-1; IWP kg/m2","thresholds":{"T_K_less":263.15,"reflectivity_dBZ_greater":18},"support":"TRMM collocated 0.5deg grid","requirements":["radar reflectivity","ice path"],"scm":"unavailable: no validated reflectivity support"},
    {"id":"ice_mass_flux_product","version":"Barthe2010_eq3to5","equation":"9e-15*fp*fnp+13.4","coefficients":{"a":9e-15,"b":13.4},"units":"flashes min-1; fp kg m/s; fnp kg/s","thresholds":{"T_K_less":268.15},"support":"storm volume, observed divergence variant distinct from model fall-speed variant","requirements":["terminal velocities","divergence or documented modeled variant","geometry"],"scm":"unavailable: missing required fields"},
    {"id":"updraft_volume","version":"Barthe2010_eq6","equation":"6.75e-11*w5-13.9","coefficients":{"a":6.75e-11,"b":-13.9},"units":"flashes min-1; w5 m3","thresholds":{"w_m_s_greater":5,"T_K_less":268.15},"support":"storm convective volume","requirements":["resolved w","volume"],"scm":"unavailable: unresolved convective volume"},
    {"id":"PR92_echo_top","version":"Barthe2010_eq7","equation":"3.44e-5*H_km^4.9","coefficients":{"a":3.44e-5,"exponent":4.9},"units":"flashes min-1","thresholds":{"echo_dBZ":20},"support":"continental storm 20dBZ top","requirements":["validated reflectivity echo top"],"scm":"unavailable: no echo top"},
    {"id":"PR92_wmax","version":"Barthe2010_eq8","equation":"5e-6*wmax^4.5","coefficients":{"a":5e-6,"exponent":4.5},"units":"flashes min-1; w m/s","thresholds":{},"support":"continental convective storm maximum","requirements":["resolved convective wmax"],"scm":"unavailable: no convective wmax"}
  ]
}
